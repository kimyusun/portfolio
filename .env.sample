# OpenAI
OPENAI_API_KEY=<openai-api-key>
GPT_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.6
OPENAI_MAX_TOKENS=300

# Database
DATABASE_URL=mysql+aiomysql://<db-user>:<db-password>@<db-host>:3306/geomemo?charset=utf8mb4
MYSQL_SSL=0

# RabbitMQ / Amazon MQ
AMQP_URL=amqps://<mq-user>:<mq-password>@<mq-host>:5671/
AMQP_CONN_NAME=geomemo-ai
MQ_QUEUE_TYPE=quorum

# Queue names
RECO_REQ_QUEUE=reco.req
RECO_RES_QUEUE=reco.res
EMOTION_REQ_QUEUE=emotion.req
INSIGHT_REQ_QUEUE=insight.req

# Worker concurrency
RECO_PREFETCH=8
EMOTION_PREFETCH=16
INSIGHT_PREFETCH=16

# DB table names
EMOTION_TABLE=EmotionEntity
INSIGHT_TABLE=InsightEntity
INSIGHT_STATUS=DONE
INSIGHT_STATUS_PENDING=PENDING
INSIGHT_PK_COL=insight_id
INSIGHT_CREATED_AT_COL=createdAt

# Local model
EMO_MODEL_DIR=./kc_saved_model

# Optional event cache consumer
EVENTS_EXCHANGE=geomemo.events
EVENTS_QUEUE=geomemo.events.cache
EVENTS_KEYS=location.upsert,memo.upsert,memo.delete,scrap.event,follow.event
